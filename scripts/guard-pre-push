#!/usr/bin/env bash
set -eo pipefail

remote_name=${1:-unknown}
zero_re='^0+$'

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  [[ "$local_sha" =~ $zero_re ]] && continue

  excluded=()
  if [[ ! "$remote_sha" =~ $zero_re ]]; then
    excluded+=("$remote_sha")
  fi
  while IFS= read -r tracked_sha; do
    [[ -n "$tracked_sha" ]] && excluded+=("$tracked_sha")
  done < <(git for-each-ref --format='%(objectname)' "refs/remotes/$remote_name/")

  revisions=("$local_sha")
  if ((${#excluded[@]})); then
    revisions+=(--not "${excluded[@]}")
  fi

  commits=$(git rev-list "${revisions[@]}")
  while IFS= read -r commit; do
    [[ -n "$commit" ]] || continue
    tree_paths=$(git ls-tree -r --name-only "$commit" -- .scratch docs/adr GLOSSARY.md docs/agents)
    if [[ -n "$tree_paths" ]]; then
      printf 'Push blocked to %s: outgoing commit %s contains local material paths:\n' "$remote_name" "$commit" >&2
      printf '%s\n' "$tree_paths" >&2
      exit 1
    fi
  done <<< "$commits"
done
